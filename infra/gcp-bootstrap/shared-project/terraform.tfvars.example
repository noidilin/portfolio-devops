# Copy to terraform.tfvars and replace placeholders with your account values.
# Do not commit terraform.tfvars; it is intentionally ignored.

project_id         = "your-existing-gcp-project-id"
billing_account_id = "000000-000000-000000"
github_repository  = "OWNER/REPO"

# Tokyo defaults keep the GCP labs geographically aligned with the existing AWS labs.
default_region        = "asia-northeast1"
default_zone          = "asia-northeast1-a"
state_bucket_location = "asia-northeast1"

# Defaults to <project_id>-tf-state when omitted.
# state_bucket_name = "your-existing-gcp-project-id-tf-state"

# Use 10/USD for a USD billing account, or set a local-currency equivalent
# that represents roughly USD $10 for your billing account currency.
budget_amount_units = 10
budget_amount_nanos = 0
budget_currency     = "USD"

labels = {
  project     = "devops-lab"
  environment = "bootstrap"
  lab         = "shared"
  managed_by  = "terraform"
  service     = "shared-foundation"
}
