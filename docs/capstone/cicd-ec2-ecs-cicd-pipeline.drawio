        <mxCell id="step-8-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Runtime pulls the promoted image&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Lab 05 EC2 Docker and Lab 06 ECS Express deploy the exact ECR SHA tag.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-8-legend"><mxGeometry height="72" width="548" x="52" as="geometry" /></mxCell>

        <mxCell id="legend-note" value="&lt;i&gt;Bootstrap resources are durable. Runtime resources are disposable and can be destroyed without deleting OIDC, IAM roles, or ECR history.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="legend-container">
